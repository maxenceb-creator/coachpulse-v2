rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function user() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function access(teamId) {
      return get(/databases/$(database)/documents/userTeamAccess/$(request.auth.uid + '_' + teamId));
    }

    function activeAccess(teamId) {
      return activeUser()
        && access(teamId).data.status == 'ACTIVE'
        && (!('startDate' in access(teamId).data) || access(teamId).data.startDate <= request.time)
        && (!('endDate' in access(teamId).data) || access(teamId).data.endDate >= request.time);
    }

    function validRole(roleId) {
      return roleId in user().data.roleIds
        && get(/databases/$(database)/documents/roles/$(roleId)).data.isActive == true;
    }

    function canInSecurityContext(teamId, seasonId, permission) {
      let context = user().data.securityContext;
      return activeUser()
        && context.activeTeamId == teamId
        && context.activeSeasonId == seasonId
        && validRole(context.activeRoleId)
        && activeAccess(teamId)
        && context.activeRoleId in access(teamId).data.rolePermissions
        && access(teamId).data.rolePermissions[context.activeRoleId].permissions.hasAny([permission]);
    }

    function canInActiveSecurityContext(permission) {
      let context = user().data.securityContext;
      return canInSecurityContext(
        context.activeTeamId,
        context.activeSeasonId,
        permission
      );
    }

    function benchmarkInActiveCategory(benchmark) {
      let context = user().data.securityContext;
      let team = get(/databases/$(database)/documents/teams/$(context.activeTeamId));
      let category = get(/databases/$(database)/documents/categories/$(team.data.categoryId));
      let subCategory = get(
        /databases/$(database)/documents/subCategories/$(benchmark.subCategoryId)
      );
      return team.data.teamType == 'DEVELOPMENT'
        && team.data.seasonId == context.activeSeasonId
        && category.data.seasonId == context.activeSeasonId
        && benchmark.subCategoryId in category.data.subCategoryIds
        && benchmark.seasonId == context.activeSeasonId
        && subCategory.data.seasonId == context.activeSeasonId;
    }

    function isActiveTestsCategory(categoryId, seasonId) {
      let context = user().data.securityContext;
      let team = get(/databases/$(database)/documents/teams/$(context.activeTeamId));
      return canInActiveSecurityContext('tests.read')
        && team.data.categoryId == categoryId
        && seasonId == context.activeSeasonId;
    }

    function isActiveTestsSubCategory(subCategoryId, seasonId) {
      let context = user().data.securityContext;
      let team = get(/databases/$(database)/documents/teams/$(context.activeTeamId));
      let category = get(/databases/$(database)/documents/categories/$(team.data.categoryId));
      return canInActiveSecurityContext('tests.read')
        && subCategoryId in category.data.subCategoryIds
        && seasonId == context.activeSeasonId;
    }

    function validRequestedSecurityContext() {
      let context = request.resource.data.securityContext;
      return context.keys().hasOnly(['activeRoleId', 'activeTeamId', 'activeSeasonId'])
        && validRole(context.activeRoleId)
        && activeAccess(context.activeTeamId)
        && context.activeRoleId in access(context.activeTeamId).data.rolePermissions
        && get(/databases/$(database)/documents/teams/$(context.activeTeamId)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/seasons/$(context.activeSeasonId)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/seasons/$(context.activeSeasonId)).data.isActive == true;
    }

    function activePlayerScope(playerId, teamId, seasonId) {
      let scope = get(
        /databases/$(database)/documents/playerAccessScopes/$(playerId + '_' + teamId + '_' + seasonId)
      );
      return scope.data.playerId == playerId
        && scope.data.teamId == teamId
        && scope.data.seasonId == seasonId
        && scope.data.source == 'PLAYER_TEAM_ASSIGNMENT'
        && scope.data.status == 'ACTIVE'
        && (!('startDate' in scope.data) || scope.data.startDate <= request.time)
        && (!('endDate' in scope.data) || scope.data.endDate >= request.time);
    }

    function playerScopeAt(playerId, teamId, seasonId, effectiveAt) {
      let scope = get(
        /databases/$(database)/documents/playerAccessScopes/$(playerId + '_' + teamId + '_' + seasonId)
      );
      return scope.data.playerId == playerId
        && scope.data.teamId == teamId
        && scope.data.seasonId == seasonId
        && scope.data.source == 'PLAYER_TEAM_ASSIGNMENT'
        && scope.data.status == 'ACTIVE'
        && (!('startDate' in scope.data) || scope.data.startDate <= effectiveAt)
        && (!('endDate' in scope.data) || scope.data.endDate >= effectiveAt);
    }

    function validTestTeamContext(data, permission) {
      let team = get(/databases/$(database)/documents/teams/$(data.teamId));
      let season = get(/databases/$(database)/documents/seasons/$(data.seasonId));
      return canInSecurityContext(data.teamId, data.seasonId, permission)
        && team.data.status == 'ACTIVE'
        && team.data.teamType == 'DEVELOPMENT'
        && team.data.seasonId == data.seasonId
        && team.data.categoryId == data.categoryId
        && season.data.status == 'ACTIVE';
    }

    function validTestReadContext(data) {
      let team = get(/databases/$(database)/documents/teams/$(data.teamId));
      return canInSecurityContext(data.teamId, data.seasonId, 'tests.read')
        && team.data.status == 'ACTIVE'
        && team.data.teamType == 'DEVELOPMENT'
        && team.data.seasonId == data.seasonId;
    }

    function validTestSessionCreate() {
      let data = request.resource.data;
      let definition = get(
        /databases/$(database)/documents/testDefinitions/$(data.testDefinitionId)
      );
      return data.keys().hasOnly([
          'testDefinitionId', 'testDefinitionVersion', 'teamId', 'seasonId',
          'categoryId', 'date', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.status == 'DRAFT'
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && data.testDefinitionVersion == definition.data.version
        && definition.data.status == 'ACTIVE'
        && validTestTeamContext(data, 'tests.write');
    }

    function validTestDefinitionCreate(testDefinitionId) {
      let data = request.resource.data;
      return canInActiveSecurityContext('tests.manage')
        && data.keys().hasOnly([
          'name', 'code', 'description', 'domain', 'status', 'version',
          'metrics', 'attemptPolicy', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.code is string
        && data.domain in ['TECHNICAL', 'PHYSICAL']
        && data.status == 'DRAFT'
        && data.version is int
        && data.version > 0
        && data.metrics is list
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validTestDefinitionUpdate() {
      let data = request.resource.data;
      let immutable = data.code == resource.data.code
        && data.version == resource.data.version
        && data.createdAt == resource.data.createdAt
        && (
          (!('createdBy' in resource.data) && !('createdBy' in data))
          || data.createdBy == resource.data.createdBy
        );
      let draftEdit = resource.data.status == 'DRAFT'
        && data.status in ['DRAFT', 'ACTIVE']
        && (data.status != 'ACTIVE' || data.metrics.size() > 0);
      let archiveOnly = resource.data.status in ['ACTIVE', 'INACTIVE']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && data.status == 'ARCHIVED';
      return canInActiveSecurityContext('tests.manage')
        && immutable
        && data.keys().hasOnly([
          'name', 'code', 'description', 'domain', 'status', 'version',
          'metrics', 'attemptPolicy', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.code is string
        && data.domain in ['TECHNICAL', 'PHYSICAL']
        && data.version is int
        && data.version > 0
        && data.metrics is list
        && data.updatedAt == request.time
        && (draftEdit || archiveOnly);
    }

    function validBenchmarkWrite(testBenchmarkId, creating) {
      let data = request.resource.data;
      let definition = get(
        /databases/$(database)/documents/testDefinitions/$(data.testDefinitionId)
      );
      return canInActiveSecurityContext('tests.manage')
        && benchmarkInActiveCategory(data)
        && data.keys().hasOnly([
          'testDefinitionId', 'testDefinitionVersion', 'metricKey',
          'subCategoryId', 'seasonId', 'benchmarkLevel', 'targetValue',
          'label', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.testDefinitionVersion == definition.data.version
        && data.benchmarkLevel in ['TARGET', 'GOOD', 'VERY_GOOD', 'REFERENCE']
        && data.targetValue is number
        && data.status in ['ACTIVE', 'ARCHIVED']
        && data.updatedAt == request.time
        && (
          (creating
            && data.createdBy == request.auth.uid
            && data.createdAt == request.time)
          || (!creating
            && data.createdBy == resource.data.createdBy
            && data.createdAt == resource.data.createdAt
            && data.testDefinitionId == resource.data.testDefinitionId
            && data.testDefinitionVersion == resource.data.testDefinitionVersion
            && data.metricKey == resource.data.metricKey
            && data.subCategoryId == resource.data.subCategoryId
            && data.seasonId == resource.data.seasonId
            && data.benchmarkLevel == resource.data.benchmarkLevel)
        );
    }

    function testSessionAfter(sessionId) {
      return getAfter(/databases/$(database)/documents/testSessions/$(sessionId));
    }

    function validTestResult(resultId, creating) {
      let data = request.resource.data;
      let session = testSessionAfter(data.testSessionId);
      let beforeSession = get(
        /databases/$(database)/documents/testSessions/$(data.testSessionId)
      );
      return resultId == data.testSessionId + '_' + data.playerId
        && data.keys().hasOnly([
          'testSessionId', 'testDefinitionId', 'testDefinitionVersion',
          'playerId', 'teamId', 'seasonId', 'values', 'contextSnapshot',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.values is map
        && data.values.size() > 0
        && data.testDefinitionId == session.data.testDefinitionId
        && data.testDefinitionVersion == session.data.testDefinitionVersion
        && data.teamId == session.data.teamId
        && data.seasonId == session.data.seasonId
        && beforeSession.data.status == 'DRAFT'
        && session.data.status in ['DRAFT', 'COMPLETED']
        && data.createdBy == request.auth.uid
        && (
          (creating && data.createdAt <= request.time)
          || (!creating
            && data.createdAt == resource.data.createdAt
            && data.createdBy == resource.data.createdBy)
        )
        && data.updatedAt == request.time
        && validTestTeamContext(session.data, 'tests.write')
        && playerScopeAt(
          data.playerId,
          session.data.teamId,
          session.data.seasonId,
          session.data.date
        );
    }

    function canReadTestResult(data) {
      let team = get(/databases/$(database)/documents/teams/$(data.teamId));
      return canInSecurityContext(data.teamId, data.seasonId, 'tests.read')
        && team.data.status == 'ACTIVE'
        && team.data.teamType == 'DEVELOPMENT'
        && team.data.seasonId == data.seasonId;
    }

    function canDeleteTestResult(data) {
      let session = get(
        /databases/$(database)/documents/testSessions/$(data.testSessionId)
      );
      return data.teamId == session.data.teamId
        && data.seasonId == session.data.seasonId
        && data.testDefinitionId == session.data.testDefinitionId
        && data.testDefinitionVersion == session.data.testDefinitionVersion
        && validTestTeamContext(session.data, 'tests.write');
    }

    match /users/{userId} {
      allow read: if activeUser() && request.auth.uid == userId;
      allow update: if activeUser()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['securityContext'])
        && validRequestedSecurityContext();
    }

    match /roles/{roleId} {
      allow read: if activeUser()
        && roleId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleIds;
    }

    match /userTeamAccess/{accessId} {
      allow read: if activeUser() && resource.data.userId == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if activeAccess(teamId);
    }

    match /seasons/{seasonId} {
      allow read: if activeUser() && resource.data.status == 'ACTIVE' && resource.data.isActive == true;
    }

    match /categories/{categoryId} {
      allow read: if isActiveTestsCategory(categoryId, resource.data.seasonId);
    }

    match /subCategories/{subCategoryId} {
      allow read: if isActiveTestsSubCategory(
        subCategoryId,
        resource.data.seasonId
      );
    }

    match /playerTeamAssignments/{assignmentId} {
      allow read: if resource.data.status == 'ACTIVE'
        && canInSecurityContext(resource.data.teamId, resource.data.seasonId, 'players.read');
    }

    match /playerAccessScopes/{scopeId} {
      allow read, write: if false;
    }

    match /players/{playerId} {
      allow read: if resource.data.status == 'ACTIVE'
        && canInSecurityContext(
          user().data.securityContext.activeTeamId,
          user().data.securityContext.activeSeasonId,
          'players.read'
        )
        && activePlayerScope(
          playerId,
          user().data.securityContext.activeTeamId,
          user().data.securityContext.activeSeasonId
        );
    }

    match /testDefinitions/{testDefinitionId} {
      allow read: if canInActiveSecurityContext('tests.read');
      allow create: if validTestDefinitionCreate(testDefinitionId);
      allow update: if validTestDefinitionUpdate();
      allow delete: if canInActiveSecurityContext('tests.manage')
        && resource.data.status == 'DRAFT';
    }

    match /testBenchmarks/{testBenchmarkId} {
      allow read: if canInActiveSecurityContext('tests.read')
        && benchmarkInActiveCategory(resource.data);
      allow create: if validBenchmarkWrite(testBenchmarkId, true);
      allow update: if validBenchmarkWrite(testBenchmarkId, false);
      allow delete: if false;
    }

    match /testSessions/{testSessionId} {
      allow read: if validTestReadContext(resource.data);
      allow create: if validTestSessionCreate();
      allow update: if validTestTeamContext(resource.data, 'tests.write')
        && resource.data.status == 'DRAFT'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'COMPLETED'
        && request.resource.data.updatedAt == request.time;
      allow delete: if validTestTeamContext(resource.data, 'tests.write');
    }

    match /testResults/{testResultId} {
      allow read: if canReadTestResult(resource.data);
      allow create: if validTestResult(testResultId, true);
      allow update: if validTestResult(testResultId, false);
      allow delete: if canDeleteTestResult(resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
